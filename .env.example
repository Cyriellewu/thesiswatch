# Copy to `.env`.

ALPHA_DB_PATH=data/alphawatch.db

# Data & markets
FINNHUB_TOKEN=

FRED_API_KEY=
FRED_DXY_SERIES=DTWEXBGS

# Force deterministic stubs (skip Yahoo/FRED/FinnHub live calls): 1=yes
ALPHAWATCH_OFFLINE=

# Alpaca Paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# LLM
GEMINI_API_KEY=
GEMINI_FLASH_LITE_MODEL=gemini-2.0-flash-lite
GEMINI_FLASH_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=2048
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
# Append one row per `TokenGuard.call` to SQLite: set to 1 to disable
ALPHA_LLML_LOG_DISABLED=0

# Push (ntfy); email stays off unless ALPHA_EMAIL_ENABLED=1
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_ACCESS_TOKEN=

ALPHA_EMAIL_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_TO=

CACHE_TTL_NEWS=900
NEWS_FINNHUB_SYMBOL_CAP=12
